# NEXORA Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to version control (.gitignore already excludes it)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=NEXORA
APP_VERSION=0.1.0

# development | production | test
ENVIRONMENT=development

# Set to true for additional debug output (not for production)
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose (connecting from backend container to db container):
#   DATABASE_URL=postgresql+asyncpg://nexora:nexora_password@db:5432/nexora
#
# Local development (backend runs on host, DB in Docker):
#   DATABASE_URL=postgresql+asyncpg://nexora:nexora_password@localhost:5432/nexora
DATABASE_URL=postgresql+asyncpg://nexora:nexora_password@localhost:5432/nexora

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Set to true to log every SQL query (very noisy, only for debugging)
DB_ECHO=false

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Required from Phase 9 onward. Get from: Razorpay Dashboard → Settings → API Keys
# Use TEST MODE keys only — they start with rzp_test_
#
# RAZORPAY_KEY_ID   — safe to expose to the frontend (starts with rzp_test_)
# RAZORPAY_KEY_SECRET — NEVER send to the frontend
# RAZORPAY_WEBHOOK_SECRET — set this in Razorpay Dashboard → Webhooks → Secret
#                           This is DIFFERENT from RAZORPAY_KEY_SECRET
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── LLM ──────────────────────────────────────────────────────────────────────
# Required from Phase 5 onward.
LLM_API_KEY=REPLACE_WITH_YOUR_LLM_API_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins for the browser
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_NEGOTIATION_ROUNDS=10
NEGOTIATION_TIMEOUT_MINUTES=30
MAX_TOOL_RETRIES=3
