# NEXORA Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Application ─────────────────────────────────────────────────────
APP_NAME=NEXORA
ENVIRONMENT=development
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────
# For Docker Compose: postgresql+asyncpg://nexora:nexora_password@db:5432/nexora
# For local dev: postgresql+asyncpg://nexora:nexora_password@localhost:5432/nexora
DATABASE_URL=postgresql+asyncpg://nexora:nexora_password@localhost:5432/nexora

# ── Razorpay (Test Mode) ─────────────────────────────────────────────
# Get these from: Razorpay Dashboard → Settings → API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Get this from: Razorpay Dashboard → Settings → Webhooks → Add Webhook → Secret
# This is DIFFERENT from KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

RAZORPAY_TEST_MODE=true

# ── LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# ── Agent Settings ───────────────────────────────────────────────────
MAX_NEGOTIATION_ROUNDS=10
NEGOTIATION_TIMEOUT_MINUTES=30
MAX_TOOL_RETRIES=3
DEFAULT_AUTONOMOUS_LIMIT=1000000.00

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Demo Mode ────────────────────────────────────────────────────────
# Set to "cached" to use pre-recorded agent responses during demo
DEMO_MODE=live
